class Solution {
    public boolean isPalindrome(String s) {
        String str = s.toLowerCase();

        str = str.replaceAll("[^a-zA-Z0-9]","");

        int left = 0;
        int right = str.length() - 1;

        while (left < right) {
            if (str.charAt(left) == str.charAt(right)) {
                left = left + 1;
                right = right - 1;
            } else {
                return false;

            }
        }
     return true;
    }
}